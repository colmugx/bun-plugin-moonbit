{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "esnext",
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["src", "test"],
  "exclude": ["test/fixtures"]
}
